{
  "name": "@chanyuxi/eslint-waltz",
  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@10.4.1",
  "description": "A composable ESLint flat config for JavaScript, TypeScript, JSONC, imports, React, Tailwind CSS, Perfectionist, and Vitest.",
  "author": "chanyuxi <2438149743@qq.com> (https://github.com/chanyuxi)",
  "license": "ISC",
  "homepage": "https://github.com/chanyuxi/eslint-waltz",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanyuxi/eslint-waltz.git"
  },
  "bugs": {
    "url": "https://github.com/chanyuxi/eslint-waltz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chanyuxi",
    "eslint",
    "config",
    "integration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "eslint-waltz": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rimraf ./dist && pnpm gen && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "gen": "tsx scripts/typegen.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typeCheck": "pnpm gen && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm run typeCheck && pnpm run lint && pnpm run test",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react-debug": "^5.19.0",
    "eslint-plugin-react-dom": "^5.19.0",
    "eslint-plugin-react-hooks-extra": "^2.13.0",
    "eslint-plugin-react-naming-convention": "^5.19.0",
    "eslint-plugin-react-web-api": "^5.19.0",
    "eslint-plugin-react-x": "^5.19.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsonc-eslint-parser": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-config-flat-gitignore": {
      "optional": true
    },
    "eslint-plugin-react-debug": {
      "optional": true
    },
    "eslint-plugin-react-dom": {
      "optional": true
    },
    "eslint-plugin-react-hooks-extra": {
      "optional": true
    },
    "eslint-plugin-react-naming-convention": {
      "optional": true
    },
    "eslint-plugin-react-web-api": {
      "optional": true
    },
    "eslint-plugin-react-x": {
      "optional": true
    },
    "eslint-plugin-tailwindcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "globals": "^17.12.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.1.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react-debug": "^5.19.0",
    "eslint-plugin-react-dom": "^5.19.0",
    "eslint-plugin-react-hooks-extra": "^2.13.0",
    "eslint-plugin-react-naming-convention": "^5.19.0",
    "eslint-plugin-react-web-api": "^5.19.0",
    "eslint-plugin-react-x": "^5.19.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-typegen": "^2.3.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.18"
  }
}
