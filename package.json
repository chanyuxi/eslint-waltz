{
  "name": "@chanyuxi/eslint-waltz",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.4.1",
  "description": "A composable ESLint flat config for JavaScript, TypeScript, JSONC, imports, and React.",
  "author": "chanyuxi <2438149743@qq.com> (https://github.com/chanyuxi)",
  "license": "ISC",
  "homepage": "https://github.com/chanyuxi/eslint-waltz",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanyuxi/eslint-waltz.git"
  },
  "bugs": {
    "url": "https://github.com/chanyuxi/eslint-waltz/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chanyuxi",
    "eslint",
    "config",
    "integration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "eslint-waltz": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "rimraf ./dist && pnpm gen && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "gen": "tsx scripts/typegen.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typeCheck": "pnpm gen && tsc --noEmit",
    "test": "node --import tsx test/index.ts",
    "check": "pnpm run typeCheck && pnpm run lint && pnpm run test",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@eslint/js": "^9.32.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "eslint": "^9.32.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-react-debug": "^1.52.3",
    "eslint-plugin-react-dom": "^1.52.3",
    "eslint-plugin-react-hooks-extra": "^1.52.3",
    "eslint-plugin-react-naming-convention": "^1.52.3",
    "eslint-plugin-react-web-api": "^1.52.3",
    "eslint-plugin-react-x": "^1.52.3",
    "globals": "^16.3.0",
    "jsonc-eslint-parser": "^2.4.0",
    "typescript-eslint": "^8.38.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-flat-gitignore": {
      "optional": true
    },
    "eslint-plugin-react-debug": {
      "optional": true
    },
    "eslint-plugin-react-dom": {
      "optional": true
    },
    "eslint-plugin-react-hooks-extra": {
      "optional": true
    },
    "eslint-plugin-react-naming-convention": {
      "optional": true
    },
    "eslint-plugin-react-web-api": {
      "optional": true
    },
    "eslint-plugin-react-x": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-react-debug": "^1.52.3",
    "eslint-plugin-react-dom": "^1.52.3",
    "eslint-plugin-react-hooks-extra": "^1.52.3",
    "eslint-plugin-react-naming-convention": "^1.52.3",
    "eslint-plugin-react-web-api": "^1.52.3",
    "eslint-plugin-react-x": "^1.52.3",
    "eslint-typegen": "^2.3.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "jsonc-eslint-parser": "^2.4.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
